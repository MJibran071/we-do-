# Environment Variables Template
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to version control

# Database Configuration
DB_USER=wedo_prod_user
DB_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# JWT Authentication
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET

# Encryption Key for Vault Service
ENCRYPTION_KEY=CHANGE_ME_GENERATE_SECURE_KEY

# API Keys
API_KEY=CHANGE_ME_YOUR_API_KEY
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_API_KEY

# Payment Providers
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Generate secure secrets with:
# openssl rand -base64 32
